# LinkedIn Personal Archive — Beispielkonfiguration
#
#   cp .env-example .env
#   chmod 600 .env
#
# Danach alle REPLACE_-Platzhalter ersetzen. Zufallswerte erzeugen mit:
#   openssl rand -hex 32
#
# .env enthält Zugangsdaten und gehört nicht ins Git-Repository.
# Geänderte Werte wirken erst nach `docker compose up -d --force-recreate`;
# `docker compose restart` übernimmt sie nicht.

# ---------------------------------------------------------------------------
# Pflichtwerte
# ---------------------------------------------------------------------------

# OAuth Access Token der Member Data Portability API (Scope
# r_dma_portability_self_serve). Nicht die Client-ID, nicht das Client Secret.
# Siehe README, Abschnitt «LinkedIn: Wie bekomme ich den API-Zugang?».
LINKEDIN_ACCESS_TOKEN=REPLACE_WITH_LINKEDIN_OAUTH_ACCESS_TOKEN

# Passwort des Anwendungsbenutzers der Datenbank.
MARIADB_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD

# Separates Passwort für die MariaDB-Initialisierung. Muss sich vom
# Anwendungspasswort unterscheiden.
MARIADB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_ROOT_PASSWORD

# Geheimnis für den Header X-Archive-Key des Rohdaten-Endpunkts. Ein dritter,
# eigener Zufallswert. Nur serverseitig verwenden, nie im Browser oder in
# WordPress-HTML. Leer oder mit REPLACE_ beginnend => /api/v1/raw/posts
# antwortet mit 503.
API_READ_KEY=REPLACE_WITH_RANDOM_API_READ_KEY

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------

# Innerhalb von Compose ist `db` der Dienstname; kein Port wird am Host
# veröffentlicht.
DB_HOST=db
DB_PORT=3306
MARIADB_DATABASE=linkedin_archive
MARIADB_USER=linkedin

# ---------------------------------------------------------------------------
# Zeitplan
# ---------------------------------------------------------------------------

# Pause zwischen zwei abgeschlossenen Durchläufen, in Sekunden.
SYNC_INTERVAL_SECONDS=3600

# Intervall für den historischen Snapshot-Abgleich, in Sekunden.
SNAPSHOT_INTERVAL_SECONDS=86400

# Nach wie vielen Tagen erfolgreich gelesene Beitragsseiten und Zähler
# erneut besucht werden.
POST_REFRESH_DAYS=1

# Wartezeit vor dem nächsten Versuch nach einem Seiten- oder Medienfehler.
RETRY_INTERVAL_SECONDS=3600

# Höchstzahl der Seitenanreicherungen pro Durchlauf. Die API-Metadaten werden
# unabhängig davon vollständig eingelesen.
MAX_POSTS_PER_CYCLE=20

# Mindestabstand zwischen zwei Beitragsseiten, in Sekunden.
PAGE_DELAY_SECONDS=5

# Timeout pro Netzwerk- oder Browseroperation, in Sekunden.
REQUEST_TIMEOUT_SECONDS=45

# Obergrenze gegen endlose API-Paginierung.
MAX_API_PAGES=10000

# ---------------------------------------------------------------------------
# Seitenanreicherung
# ---------------------------------------------------------------------------

# Öffentliche Beitragsseite lesen, um Personen-, Firmen- und Hashtag-Links
# sowie Medien zu erhalten. Auf false begrenzt den Betrieb auf die
# offizielle API; dann fehlen bei leeren API-Medienfeldern Bilder und
# Erwähnungslinks.
PAGE_ENRICHMENT_ENABLED=true

# Chromium/Playwright versuchen, wenn der einfache HTTP-Abruf nicht reicht.
BROWSER_FALLBACK_ENABLED=true

# Optionaler Playwright-Storage-State für eigene eingeschränkte Beiträge.
# Leer lassen, wenn kein angemeldeter Browser verwendet wird. Sonst der Pfad
# im Container, üblicherweise /run/secrets/linkedin-state.json.
BROWSER_STORAGE_STATE=

# ---------------------------------------------------------------------------
# Medien
# ---------------------------------------------------------------------------

# Erreichbare Mediendateien dauerhaft herunterladen.
DOWNLOAD_MEDIA=true

# Obergrenze pro Datei, in MB.
MAX_MEDIA_SIZE_MB=100

# Erlaubte Medienhosts, inklusive Subdomains, kommagetrennt. OAuth-Header
# werden ausschliesslich an api.linkedin.com gesendet, nie an diese Hosts.
# Beispiel für externe Vorschaubilder: licdn.com,linkedin.com,images.credly.com
MEDIA_ALLOWED_HOSTS=licdn.com,linkedin.com

# ---------------------------------------------------------------------------
# HTTP-API für die Website
# ---------------------------------------------------------------------------

# Bind-Adresse und Host-Port. 127.0.0.1 hält die API auf dem Docker-Host.
# Erst ändern, wenn ein Reverse-Proxy davorliegt.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080

# Öffentliche Basis-URL, aus der die absoluten Bild-URLs gebildet werden.
# Bei Betrieb hinter einem Reverse-Proxy auf dessen HTTPS-Adresse setzen,
# zum Beispiel https://www.glogger.ch/linkedin-api
API_PUBLIC_BASE_URL=http://localhost:8080

# Erlaubter Browser-Origin für CORS. Nur für eine direkte
# JavaScript-Einbindung nötig; der WordPress-Shortcode braucht kein CORS.
API_ALLOWED_ORIGIN=https://www.glogger.ch

# ---------------------------------------------------------------------------
# Ablageorte
# ---------------------------------------------------------------------------

# MEDIA_DIR und EXPORT_DIR setzt docker-compose.yml fest auf /data/media und
# /data/export im Volume `archive-data`. Ein Eintrag hier bleibt wirkungslos;
# für einen anderen Pfad die Compose-Datei anpassen. Nur bei einem Lauf
# ausserhalb von Docker sind sie hier sinnvoll:
# MEDIA_DIR=/data/media
# EXPORT_DIR=/data/export

# ---------------------------------------------------------------------------
# Protokollierung
# ---------------------------------------------------------------------------

# DEBUG, INFO, WARNING oder ERROR.
LOG_LEVEL=INFO
